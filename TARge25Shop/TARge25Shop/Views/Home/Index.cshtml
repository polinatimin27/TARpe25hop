@{
    ViewData["Title"] = "Home";
}

<style>
    .home-page {
        padding: 65px 0;
        text-align: center;
    }

        .home-page h1 {
            font-family: Georgia, serif;
            font-size: 55px;
            color: #f0dfc8;
            margin-bottom: 15px;
        }

    .home-subtitle {
        color: #cbb59a;
        font-size: 17px;
        margin-bottom: 25px;
    }

    .home-line {
        width: 100px;
        height: 1px;
        background-color: #b08a57;
        margin: 0 auto 55px;
    }

    .project-card {
        display: block;
        background-color: #241b17;
        border: 1px solid #6b4e36;
        padding: 38px 25px;
        text-decoration: none;
        height: 100%;
        transition: 0.2s;
    }

        .project-card:hover {
            background-color: #32251d;
            border-color: #b08a57;
            transform: translateY(-4px);
        }

        .project-card h2 {
            font-family: Georgia, serif;
            color: #f0dfc8;
            font-size: 28px;
            margin-bottom: 15px;
        }

        .project-card p {
            color: #cbb59a;
            margin-bottom: 22px;
        }

        .project-card span {
            color: #d6b58a;
            font-size: 14px;
            letter-spacing: 1px;
        }
</style>

<div class="home-page">

    <h1>TAR25Shop</h1>

    <p class="home-subtitle">
        My ASP.NET Core MVC Projects
    </p>

    <div class="home-line"></div>

    <div class="row g-4">

        <div class="col-md-6">
            <a asp-controller="Spaceship"
                   asp-action="Index"
                   class="project-card">
                <h2>Spaceship</h2>
                <p>Spacecraft management</p>
                <span>OPEN PROJECT →</span>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="RealEstate"
                   asp-action="Index"
                   class="project-card">
                <h2>RealEstate</h2>
                <p>Property management</p>
                <span>OPEN PROJECT →</span>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Kindergarten"
                   asp-action="Index"
                   class="project-card">
                <h2>Kindergarten</h2>
                <p>Kindergarten records</p>
                <span>OPEN PROJECT →</span>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Library"
                   asp-action="Index"
                   class="project-card">
                <h2>Library</h2>
                <p>The Grand Library</p>
                <span>OPEN PROJECT →</span>
            </a>
        </div>

    </div>
</div>
