@model TARge25Shop.Core.Domain.Reader

@{
    ViewData["Title"] = "Reader Details";
}

<style>
    .reader-details {
        background: #1c1511;
        border: 1px solid #806344;
        border-radius: 6px;
        padding: 35px;
        margin: 25px 0;
        color: #f0dfc8;
    }

        .reader-details h1 {
            font: 42px Georgia, serif;
            color: #f0dfc8;
            margin-bottom: 30px;
        }

            .reader-details h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .reader-details p {
            color: #f0dfc8;
            margin-bottom: 18px;
        }

        .reader-details strong {
            color: #d7b689;
        }

        .reader-details .btn {
            padding: 10px 20px;
            margin: 3px;
            border-radius: 4px;
            color: #f0dfc8;
        }

        .reader-details .btn-warning {
            background: #765538;
            border: 1px solid #a8875a;
        }

        .reader-details .btn-secondary {
            background: #30231b;
            border: 1px solid #8c6a47;
        }

        .reader-details .btn:hover {
            background: #b08a57;
            color: #17110d;
        }
</style>

<div class="reader-details">
    <h1>Reader Details</h1>

    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>

    <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back
    </a>
</div>
