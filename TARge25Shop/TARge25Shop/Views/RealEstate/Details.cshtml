@model TARge25Shop.Models.RealEstate.RealEstateDetailsViewModel

<style>
    .realestate-page {
        background-color: #171519;
        padding: 25px;
        border: 1px solid #65404b;
        border-radius: 10px;
        min-height: 450px;
    }

        .realestate-page h1 {
            color: #f0e1ce;
            margin-bottom: 20px;
        }

            .realestate-page h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .realestate-page h4 {
            color: #e8c994;
            margin-bottom: 15px;
        }

        .realestate-page hr {
            border-color: #65404b;
            opacity: 1;
        }

        .realestate-page label {
            color: #e8c994;
        }

        .realestate-page .form-group {
            color: #e6d9cf;
            margin-bottom: 12px;
        }

        .realestate-page .back-btn {
            background-color: #792d48;
            border: 1px solid #ab6e78;
            color: white;
            margin-top: 15px;
        }

            .realestate-page .back-btn:hover {
                background-color: #903b59;
                color: white;
            }
</style>

<div class="realestate-page">

    <h1>Details</h1>

    <div>
        <h4>RealEstate</h4>
        <hr />

        <dl class="row">
            <div class="form-group row">
                <label asp-for="Id" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.Id)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="Area" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.Area)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="Location" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.Location)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.RoomNumber)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.BuildingType)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.CreatedAt)
            </div>
        </dl>

        <dl class="row">
            <div class="form-group row">
                <label asp-for="ModifiedAt" class="col-sm-2 col-form-label"></label>
                @Html.DisplayFor(model => model.ModifiedAt)
            </div>
        </dl>

        <a asp-action="Index"
               asp-controller="realEstate"
               class="btn back-btn">
            Back
        </a>
    </div>
</div>
