@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergartens";
    int rowNumber = 1;
}

<style>
    .kindergarten-page {
        background-color: #171519;
        padding: 25px;
        border: 1px solid #65404b;
        border-radius: 10px;
        min-height: 450px;
    }

        .kindergarten-page h1 {
            color: #f0e1ce;
            margin-bottom: 20px;
        }

            .kindergarten-page h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .kindergarten-page .create-btn {
            background-color: #792d48;
            border: 1px solid #ab6e78;
            color: white;
        }

            .kindergarten-page .create-btn:hover {
                background-color: #903b59;
                color: white;
            }

        .kindergarten-page table {
            background-color: #252127;
            border: 1px solid #634454;
            border-radius: 6px;
            overflow: hidden;
        }

        .kindergarten-page thead th {
            background-color: #472633;
            color: #e8c994;
            border-color: #634454;
            padding: 12px;
        }

        .kindergarten-page tbody td {
            background-color: #252127;
            color: #e6d9cf;
            border-color: #493440;
            padding: 12px;
            vertical-align: middle;
        }

        .kindergarten-page tbody tr:nth-child(even) td {
            background-color: #302630;
        }

        .kindergarten-page tbody tr:hover td {
            background-color: #3a2935;
            color: #f0e1ce;
        }

        .kindergarten-page .edit-btn {
            background-color: #725438;
            border-color: #725438;
            color: #fff1cf;
        }

        .kindergarten-page .details-btn {
            background-color: #793850;
            border-color: #793850;
            color: white;
        }

        .kindergarten-page .delete-btn {
            background-color: #4d252c;
            border-color: #4d252c;
            color: #ffdce0;
        }

        .kindergarten-page .edit-btn:hover {
            background-color: #8b6948;
            color: white;
        }

        .kindergarten-page .details-btn:hover {
            background-color: #914761;
            color: white;
        }

        .kindergarten-page .delete-btn:hover {
            background-color: #69323d;
            color: white;
        }

        .kindergarten-page td:last-child {
            white-space: nowrap;
        }
</style>

<div class="kindergarten-page">

    <h1>Kindergartens</h1>

    <p>
        <a asp-action="CreateUpdate"
               class="btn create-btn">
            Create new
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Group name</th>
                    <th>Children count</th>
                    <th>Kindergarten name</th>
                    <th>Teacher name</th>
                    <th>Created at</th>
                    <th>Updated at</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var kindergarten in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@kindergarten.GroupName</td>
                        <td>@kindergarten.ChildrenCount</td>
                        <td>@kindergarten.KindergartenName</td>
                        <td>@kindergarten.TeacherName</td>
                        <td>@kindergarten.CreatedAt</td>
                        <td>@kindergarten.UpdatedAt</td>
                        <td>
                            <a asp-action="Edit"
                                   asp-route-id="@kindergarten.Id"
                                   class="btn btn-sm edit-btn">
                                Edit
                            </a>

                            <a asp-action="Details"
                                   asp-route-id="@kindergarten.Id"
                                   class="btn btn-sm details-btn">
                                Details
                            </a>

                            <a asp-action="Delete"
                                   asp-route-id="@kindergarten.Id"
                                   class="btn btn-sm delete-btn">
                                Delete
                            </a>
                        </td>
                    </tr>

                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
</div>
