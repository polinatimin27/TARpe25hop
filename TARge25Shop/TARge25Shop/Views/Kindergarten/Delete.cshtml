@model TARge25Shop.Models.Kindergarten.KindergartenDeleteViewModel

@{
    ViewData["Title"] = "Delete kindergarten";
}

<style>
    .kindergarten-page {
        background-color: #171519;
        padding: 25px;
        border: 1px solid #65404b;
        border-radius: 10px;
        min-height: 450px;
    }

        .kindergarten-page h1 {
            color: #f0e1ce;
            margin-bottom: 20px;
        }

            .kindergarten-page h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .kindergarten-page h3 {
            color: #e8c994;
            font-size: 20px;
            margin-bottom: 25px;
        }

        .kindergarten-page dt {
            color: #e8c994;
        }

        .kindergarten-page dd {
            color: #e6d9cf;
        }

        .kindergarten-page dl {
            margin-bottom: 25px;
        }

        .kindergarten-page .delete-btn {
            background-color: #4d252c;
            border: 1px solid #75404b;
            color: #ffdce0;
        }

            .kindergarten-page .delete-btn:hover {
                background-color: #69323d;
                color: white;
            }

        .kindergarten-page .cancel-btn {
            background-color: #792d48;
            border: 1px solid #ab6e78;
            color: white;
        }

            .kindergarten-page .cancel-btn:hover {
                background-color: #903b59;
                color: white;
            }
</style>

<div class="kindergarten-page">

    <h1>Delete kindergarten</h1>

    <h3>Are you sure you want to delete this kindergarten?</h3>

    <dl class="row">
        <dt class="col-sm-3">Group name</dt>
        <dd class="col-sm-9">@Model.GroupName</dd>

        <dt class="col-sm-3">Children count</dt>
        <dd class="col-sm-9">@Model.ChildrenCount</dd>

        <dt class="col-sm-3">Kindergarten name</dt>
        <dd class="col-sm-9">@Model.KindergartenName</dd>

        <dt class="col-sm-3">Teacher name</dt>
        <dd class="col-sm-9">@Model.TeacherName</dd>

        <dt class="col-sm-3">Created at</dt>
        <dd class="col-sm-9">@Model.CreatedAt</dd>

        <dt class="col-sm-3">Updated at</dt>
        <dd class="col-sm-9">@Model.UpdatedAt</dd>
    </dl>

    <form asp-action="DeleteConfirmation" method="post">
        <input asp-for="Id" type="hidden" />

        <button type="submit" class="btn delete-btn">
            Delete
        </button>

        <a asp-action="Index" class="btn cancel-btn">
            Cancel
        </a>
    </form>

</div>
