@model TARge25Shop.Core.Dto.BookDto

@{
    ViewData["Title"] = "Edit Book";
}

<style>
    .book-edit {
        background-color: #1c1511;
        border: 1px solid #806344;
        border-radius: 6px;
        padding: 35px;
        margin: 25px 0;
        color: #f0dfc8;
    }

        .book-edit h1 {
            font-family: Georgia, serif;
            font-size: 42px;
            color: #f0dfc8;
            margin-bottom: 30px;
        }

            .book-edit h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .book-edit label {
            color: #d7b689;
            display: block;
            margin-bottom: 8px;
        }

        .book-edit .form-control {
            background-color: #2c211b;
            border: 1px solid #705438;
            color: #f0dfc8;
            border-radius: 4px;
            padding: 10px;
        }

            .book-edit .form-control:focus {
                background-color: #2c211b;
                border-color: #c8a46a;
                color: #f0dfc8;
                box-shadow: none;
            }

        .book-edit .btn {
            border-radius: 4px;
            padding: 10px 20px;
            margin: 3px;
        }

        .book-edit .btn-success {
            background-color: #765538;
            border: 1px solid #a8875a;
            color: #fff4e4;
        }

        .book-edit .btn-secondary {
            background-color: #30231b;
            border: 1px solid #8c6a47;
            color: #f0dfc8;
        }

        .book-edit .btn:hover {
            background-color: #b08a57;
            border-color: #c8a46a;
            color: #17110d;
        }
</style>

<div class="book-edit">

    <h1>Edit Book</h1>

    <form asp-controller="Books"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label>Title</label>
            <input asp-for="Title"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Author</label>
            <input asp-for="Author"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Published Year</label>
            <input asp-for="PublishedYear"
                   type="number"
                   class="form-control"
                   required />
        </div>

        <button type="submit"
                class="btn btn-success">
            Save Changes
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Back
        </a>

        <a asp-controller="Library"
               asp-action="Index"
               class="btn btn-secondary">
            Back to Library
        </a>

    </form>
</div>
