@model TARge25Shop.Core.Dto.BookDto

@{
    ViewData["Title"] = "Add Book";
}

<style>
    .book-form-page {
        background-color: #1c1511;
        border: 1px solid #806344;
        border-radius: 6px;
        padding: 35px;
        margin: 25px 0;
        color: #f0dfc8;
    }

        .book-form-page h1 {
            font-family: Georgia, serif;
            font-size: 42px;
            color: #f0dfc8;
            margin-bottom: 30px;
        }

            .book-form-page h1::before {
                content: "✦ ";
                color: #c8a46a;
            }

        .book-form-page label {
            display: block;
            color: #d7b689;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .book-form-page .form-control {
            background-color: #2c211b;
            border: 1px solid #705438;
            border-radius: 4px;
            color: #f0dfc8;
            padding: 10px;
        }

            .book-form-page .form-control:focus {
                background-color: #2c211b;
                color: #f0dfc8;
                border-color: #c8a46a;
                box-shadow: none;
            }

        .book-form-page .btn {
            border-radius: 4px;
            padding: 10px 20px;
            margin: 3px;
        }

        .book-form-page .btn-success {
            background-color: #765538;
            border: 1px solid #a8875a;
            color: #fff4e4;
        }

        .book-form-page .btn-secondary {
            background-color: #30231b;
            border: 1px solid #8c6a47;
            color: #f0dfc8;
        }

        .book-form-page .btn:hover {
            background-color: #b08a57;
            border-color: #c8a46a;
            color: #17110d;
        }
</style>

<div class="book-form-page">

    <h1>Add Book</h1>

    <form asp-controller="Books"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label>Title</label>
            <input asp-for="Title"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Author</label>
            <input asp-for="Author"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Published Year</label>
            <input asp-for="PublishedYear"
                   type="number"
                   min="1"
                   class="form-control"
                   required />
        </div>

        <button type="submit" class="btn btn-success">
            Save
        </button>

        <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-secondary">
            Back
        </a>

        <a asp-controller="Library"
               asp-action="Index"
               class="btn btn-secondary">
            Back to Library
        </a>

    </form>
</div>
