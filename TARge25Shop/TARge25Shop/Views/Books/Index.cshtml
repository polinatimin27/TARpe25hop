@model List<TARge25Shop.Core.Domain.Book>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Add Book</a>

<form method="get" class="mb-3">
    <input type="text" name="title" placeholder="Book title" />
    <input type="number" name="year" placeholder="Year" />

    <button type="submit" class="btn btn-primary">Search</button>
    <button type="submit" name="borrowed" value="true"
            class="btn btn-warning">
        Borrowed Books
    </button>

    <a asp-action="Index" class="btn btn-secondary">All Books</a>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Year</th>
            <th>Available</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.PublishedYear</td>
                <td>@(book.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@book.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <form asp-action="Delete"
                          asp-route-id="@book.Id"
                          method="post"
                          style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
