
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TARge25Shop</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TARge25Shop.styles.css" asp-append-version="true" />

    <style>
            body {
                background-color: #171519;
                color: #e9d8bd;
            }

            .main-navbar {
                background-color: #171519;
                border-bottom: 1px solid #65404b;
                margin-bottom: 25px;
            }

                .main-navbar .navbar-brand {
                    color: #e9d8bd;
                }

                    .main-navbar .navbar-brand:hover {
                        color: #c8a46a;
                    }

                    .main-navbar .navbar-brand::before {
                        content: "✦ ";
                        color: #c8a46a;
                    }

                .main-navbar .nav-link {
                    color: #c6b6bc;
                }

                    .main-navbar .nav-link:hover {
                        color: #c8a46a;
                    }

                .main-navbar .navbar-toggler {
                    border-color: #65404b;
                }

                .main-navbar .navbar-toggler-icon {
                    filter: invert(1);
                }

            .main-footer {
                border-top: 1px solid #65404b;
                color: #b8a6a9;
                padding-top: 15px;
                margin-top: 30px;
            }

                .main-footer a {
                    color: #c8a46a;
                }

                    .main-footer a:hover {
                        color: #e9d8bd;
                    }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm main-navbar">
            <div class="container-fluid">

                <a class="navbar-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                    TARge25Shop
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Spaceship"
                                   asp-action="Index">
                                Spaceship
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="RealEstate"
                                   asp-action="Index">
                                RealEstate
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Kindergarten"
                                   asp-action="Index">
                                Kindergarten
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="main-footer footer">
        <div class="container">
            &copy; 2026 - TARge25Shop -
            <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
