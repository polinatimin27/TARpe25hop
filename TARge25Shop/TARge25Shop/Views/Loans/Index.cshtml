@model List<TARge25Shop.Core.Domain.Loan>
@using TARge25Shop.Core.Domain

@{
    ViewData["Title"] = "Loans";
    var readers = ViewBag.Readers as List<Reader> ?? new List<Reader>();
}

<h1>Loans</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Loan
</a>

<form method="get" class="mb-3">
    <select name="readerId" class="form-select mb-2">
        <option value="">All Readers</option>
        @foreach (var reader in readers)
        {
            <option value="@reader.Id">@reader.FullName</option>
        }
    </select>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        All Loans
    </a>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Book</th>
            <th>Reader</th>
            <th>Loan Date</th>
            <th>Return Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.Book.Title</td>
                <td>@loan.Reader.FullName</td>
                <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @(loan.ReturnDate?.ToString("dd.MM.yyyy") ?? "Not returned")
                </td>
                <td>
                    @if (!loan.ReturnDate.HasValue)
                    {
                        <form asp-action="Return" method="post">
                            <input type="hidden" name="id" value="@loan.Id" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Return
                            </button>
                        </form>
                    }
                    else
                    {
                        <span>Returned</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
