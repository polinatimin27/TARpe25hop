@{
    ViewData["Title"] = "Library";
}

<style>
    .library-home {
        background: linear-gradient( rgba(15, 10, 7, 0.50), rgba(15, 10, 7, 0.75) ), url('/images/library-bg.jpg') center/cover;
        min-height: 650px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px;
    }

    .library-frame {
        border: 1px solid #b08a57;
        padding: 80px 45px;
        text-align: center;
        width: 100%;
        max-width: 950px;
    }

        .library-frame h1 {
            font-family: Georgia, serif;
            font-size: 55px;
            color: #f0dfc8;
            margin-bottom: 35px;
        }

    .library-link {
        display: inline-block;
        padding: 12px 25px;
        margin: 5px;
        border: 1px solid #b08a57;
        color: #f0dfc8;
        text-decoration: none;
        background-color: rgba(28, 19, 14, 0.65);
    }

        .library-link:hover {
            background-color: #b08a57;
            color: #17110d;
        }
</style>

<div class="library-home">
    <div class="library-frame">

        <h1>The Grand Library</h1>

        <a asp-controller="Books"
           asp-action="Index"
           class="library-link">Books</a>

        <a asp-controller="Readers"
           asp-action="Index"
           class="library-link">Readers</a>

        <a asp-controller="Loans"
           asp-action="Index"
           class="library-link">Loans</a>

    </div>
</div>
